        "display_name": "Cache Size",
        "help": "Controls cache size in MB for video streaming. The default is 75 MB",
        "default": 75,
        "possible_values": [
          [ 10, "Tiny (10 MB)" ],
          [ 75, "Default (75 MB)" ],
          [ 150, "Large (150 MB)", { "platforms_excluded": "oe_rpi" } ],
          [ 500, "Very Large (500 MB)", { "platforms_excluded": "oe_rpi" } ]
