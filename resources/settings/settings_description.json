  {
    "section": "watch",
    "order": 5,
    "values": [
      {
        "value": "autoSkipIntro",
        "display_name": "Auto-Skip Intros",
        "help": "When Intro Skipper (or Jellyfin Media Segments) has marked an opening, Abyssfin jumps past it automatically. Leave this off if you want to press Skip Intro yourself from the tray, OSD, or Ctrl+Shift+I.",
        "default": false
      },
      {
        "value": "autoSkipCredits",
        "display_name": "Auto-Skip Credits",
        "help": "When an ending/credits segment is detected, skip ahead to the next item in the queue. Requires Intro Skipper or chapter names like Credits/Outro. This skips the prompt below.",
        "default": false
      },
      {
        "value": "autoSkipRecap",
        "display_name": "Auto-Skip Recaps",
        "help": "Skip “previously on” recap segments when the server has marked them. Off by default because recaps are easy to confuse with cold opens.",
        "default": false
      },
      {
        "value": "promptNextEpisode",
        "display_name": "Prompt at Credits",
        "help": "Show a Next episode / Stay overlay when credits start, if auto-skip credits is off. Uses Intro Skipper outro segments, or the last 25 seconds when no segment exists.",
        "default": true
      },
      {
        "value": "sleepTimer",
        "display_name": "Sleep Timer",
        "help": "Pause playback after a delay. End of episode waits until the current video is almost finished. The menu-bar/tray Sleep Timer button cycles these same options. Default is Off.",
        "default": "off",
        "possible_values": [
          [ "off", "Off" ],
          [ "15", "15 minutes" ],
          [ "30", "30 minutes" ],
          [ "45", "45 minutes" ],
          [ "60", "60 minutes" ],
          [ "episode", "End of episode" ]
        ]
      },
      {
        "value": "sleepTimerFade",
        "display_name": "Fade Out Before Sleep",
        "help": "Lower volume over 15 seconds before the sleep timer pauses. Volume is restored after pause so the next play is not silent.",
        "default": true
      },
      {
        "value": "enableLyricsOverlay",
        "display_name": "Lyrics Overlay",
        "help": "Show synced or plain lyrics during music playback. Uses lyrics already stored on the server by the Lyrics / LrcLib plugins. Toggle with Ctrl+Shift+L. Has no effect on video.",
        "default": true
      },
      {
        "value": "rememberSeriesTracks",
        "display_name": "Remember Audio & Subtitles Per Series",
        "help": "When you pick an audio language or subtitle track, reuse it for later episodes of the same series. Applies to MPV playback only. Per-title movies use the item id instead of a series id.",
        "default": true
      },
      {
        "value": "enableAnimeThemesButton",
        "display_name": "Show OP/ED Button",
        "help": "Adds an OP/ED button on item pages that plays theme videos from Jellyfin Theme Media (the AnimeThemes plugin). If a title has no theme videos, the button still appears but reports that nothing is available. This never replaces normal Play.",
        "default": true
      }
    ]
  },
